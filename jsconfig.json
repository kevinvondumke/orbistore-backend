{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "strict": false,
    "maxNodeModuleJsDepth": 0
  },
  "typeAcquisition": {
    "enable": false
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts"
  ]
}
